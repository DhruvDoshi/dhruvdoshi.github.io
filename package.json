{
  "name": "personal-site",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://dhruvdoshi.github.io/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DhruvDoshi/dhruvdoshi.github.io.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build": "node scripts/generate-seo.mjs && vite build && node scripts/prerender.mjs && node scripts/generate-markdown.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "check": "npm run lint && npm test && npm run build && npm run validate:site && npm run audit",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "publish:notes": "node scripts/publish-scheduled-notes.mjs",
    "start": "vite",
    "test": "vitest run",
    "validate:site": "node scripts/validate-site.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "dayjs": "^1.11.21",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.11.0",
    "jsdom": "^30.0.0",
    "node-html-markdown": "^2.0.0",
    "sass": "^1.102.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
